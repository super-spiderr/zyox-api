# MongoDB connection string
MONGO_URI="mongodb+srv://<user>:<password>@<cluster-url>"

# Secret used to sign short-lived access tokens
JWT_SECRET_KEY="replace-with-a-long-random-value"

# Secret used to sign refresh tokens. Must be different from JWT_SECRET_KEY
# and set explicitly - there is no fallback.
JWT_REFRESH_SECRET_KEY="replace-with-a-different-long-random-value"

# Comma-separated list of origins allowed to call the API (e.g. the dashboard app).
# Leave unset to allow all origins (fine for local dev, not for production).
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Port the server listens on. Defaults to 3000 if unset.
PORT=3000
